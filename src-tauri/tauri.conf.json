{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CloudVault",
  "version": "1.0.0",
  "identifier": "com.cloudvault.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devtools": true
  },
  "app": {
    "windows": [
      {
        "title": "CloudVault — Your Files. One Place.",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://www.googleapis.com https://oauth2.googleapis.com https://graph.microsoft.com https://login.microsoftonline.com https://api.dropboxapi.com https://content.dropboxapi.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; media-src 'self' https: blob:; frame-src https://accounts.google.com https://login.live.com https://www.dropbox.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "http": {
      "enabled": true,
      "scope": [
        "https://www.googleapis.com/*",
        "https://oauth2.googleapis.com/*",
        "https://graph.microsoft.com/*",
        "https://login.microsoftonline.com/*",
        "https://api.dropboxapi.com/*",
        "https://content.dropboxapi.com/*",
        "https://www.dropbox.com/*"
      ]
    }
  }
}